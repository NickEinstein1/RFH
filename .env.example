# RFH System — local development environment
# Copy to apps/api/.env (never commit secrets)

# --- Database ---
# Local Postgres (default):
DATABASE_URL="postgresql://rfh:rfh_dev_password@localhost:5432/rfh_system?schema=public"
DIRECT_URL="postgresql://rfh:rfh_dev_password@localhost:5432/rfh_system?schema=public"

# Supabase Postgres (hosted backend DB) — replace [REF] and [PASSWORD]:
# Session/transaction pooler for the Nest API (port 6543):
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
# Direct connection for migrations/seed (port 5432):
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@db.[REF].supabase.co:5432/postgres?schema=public"
# Optional Studio / future client keys (Nest does not use Supabase Auth):
# SUPABASE_URL="https://[REF].supabase.co"
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

JWT_ACCESS_SECRET="dev-access-secret-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production-min-32-chars"
JWT_ACCESS_TTL="10m"
JWT_REFRESH_TTL="7d"
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
# 32-byte key, base64. Generate: openssl rand -base64 32
PHI_FIELD_KEY="ZNjml9sUvQk28EektKUbRrte9eczoS5jNM3Lf1FO3BM="

# Optional SMTP (Nodemailer). Leave SMTP_HOST empty to skip sending in local/dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RFH Care <noreply@example.com>"

# Optional fax providers (Integrations → Fax). Without keys, faxes queue in noop/dev mode.
# Telnyx Programmable Fax:
TELNYX_API_KEY=
TELNYX_FAX_CONNECTION_ID=
FAX_FROM_NUMBER=
# Twilio Fax (legacy / alternative):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FAX_FROM=

# Optional OpenAI for doctor-order photo OCR. Disabled by default — never send PHI
# to a third party unless ORDER_INTAKE_AI_ENABLED=true AND the nurse opts in per upload.
OPENAI_API_KEY=
ORDER_INTAKE_AI_ENABLED=false
ORDER_INTAKE_MODEL=gpt-4o-mini
# Optional dedicated HMAC secret for med-pass safety challenge tokens (falls back to JWT_ACCESS_SECRET)
SAFETY_CHALLENGE_SECRET=
