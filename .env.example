# RFH System — local development environment
# Copy to apps/api/.env (never commit secrets)

DATABASE_URL="postgresql://rfh:rfh_dev_password@localhost:5432/rfh_system?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production-min-32-chars"
JWT_ACCESS_TTL="10m"
JWT_REFRESH_TTL="7d"
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
# 32-byte key, base64. Generate: openssl rand -base64 32
PHI_FIELD_KEY="ZNjml9sUvQk28EektKUbRrte9eczoS5jNM3Lf1FO3BM="

# Optional SMTP (Nodemailer). Leave SMTP_HOST empty to skip sending in local/dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RFH Care <noreply@example.com>"

# Optional OpenAI for doctor-order photo OCR. Disabled by default — never send PHI
# to a third party unless ORDER_INTAKE_AI_ENABLED=true AND the nurse opts in per upload.
OPENAI_API_KEY=
ORDER_INTAKE_AI_ENABLED=false
ORDER_INTAKE_MODEL=gpt-4o-mini
# Optional dedicated HMAC secret for med-pass safety challenge tokens (falls back to JWT_ACCESS_SECRET)
SAFETY_CHALLENGE_SECRET=
