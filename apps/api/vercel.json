{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "regions": ["sfo1"],
  "functions": {
    "src/main.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**,public/**}"
    }
  }
}
